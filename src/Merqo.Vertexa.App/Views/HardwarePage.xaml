<Page x:Class="Merqo.Vertexa.App.Views.HardwarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Hardware Overview" Style="{StaticResource H1}"/>
            <TextBlock x:Name="Summary" Style="{StaticResource Muted}" Margin="0,4,0,12" Text="Press Refresh to collect real hardware data."/>
            <Button Content="Refresh" Click="Refresh_Click" Padding="14,8" HorizontalAlignment="Left"/>
            <TextBox x:Name="Details" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource SurfaceAltBrush}" Height="420" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
