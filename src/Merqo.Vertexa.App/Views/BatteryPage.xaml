<Page x:Class="Merqo.Vertexa.App.Views.BatteryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Battery Intelligence" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                Text="Wear = (Design − FullCharge)/Design × 100. Health = FullCharge/Design × 100. Calculated only when both capacities are valid; cycle count is never fabricated."/>
            <Button Content="Read Battery" Click="Read_Click" Padding="14,8" HorizontalAlignment="Left"/>
            <TextBox x:Name="Output" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" Height="380"
                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource SurfaceAltBrush}" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Page>
