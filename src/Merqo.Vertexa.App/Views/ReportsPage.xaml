<Page x:Class="Merqo.Vertexa.App.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Reports" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
            Text="Reports are generated only from a real diagnostic scan. Export includes branding, version, provenance, statuses and limitations."/>
        <StackPanel Orientation="Horizontal">
            <Button Content="Run Scan" Click="Scan_Click" Padding="14,8" Margin="0,0,8,0"/>
            <Button x:Name="JsonBtn" Content="Export JSON" Click="Json_Click" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="HtmlBtn" Content="Export HTML" Click="Html_Click" Padding="14,8" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="CsvBtn" Content="Export CSV" Click="Csv_Click" Padding="14,8" IsEnabled="False"/>
        </StackPanel>
        <TextBlock x:Name="Status" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
    </StackPanel>
</Page>
