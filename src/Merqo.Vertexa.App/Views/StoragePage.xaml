<Page x:Class="Merqo.Vertexa.App.Views.StoragePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Storage Diagnostics" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                Text="Benchmarks are non-destructive: a size-capped test file in a temp directory with a free-space check and automatic cleanup. No user data is ever touched."/>
            <StackPanel Orientation="Horizontal">
                <Button Content="List Disks" Click="List_Click" Padding="14,8" Margin="0,0,8,0"/>
                <Button x:Name="BenchBtn" Content="Safe Write Benchmark (64 MB)" Click="Bench_Click" Padding="14,8"/>
            </StackPanel>
            <TextBlock x:Name="BenchStatus" Style="{StaticResource Muted}" Margin="0,8,0"/>
            <TextBox x:Name="Output" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True" Height="360"
                     FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                     Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource SurfaceAltBrush}" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</Page>
