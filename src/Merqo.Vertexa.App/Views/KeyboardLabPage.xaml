<Page x:Class="Merqo.Vertexa.App.Views.KeyboardLabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Keyboard Testing Lab" Style="{StaticResource H1}"/>
        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
            Text="Click into the capture area, then press keys. Fn-combination behavior depends on laptop firmware and is not claimed as testable."/>
        <Border x:Name="CaptureArea" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" Height="120" Focusable="True">
            <TextBlock x:Name="Hint" Text="Click here and press any key…" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="Passed" Margin="0,12,0,0" Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="LastKey" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
</Page>
