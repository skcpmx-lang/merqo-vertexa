<Page x:Class="Merqo.Vertexa.App.Views.DisplayLabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Display Testing Lab" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12"
                Text="Fullscreen color/pattern tests. Press ESC to exit any test. Dead-pixel inspection is a user-assisted visual test — no automatic detection is claimed."/>
            <WrapPanel x:Name="Patterns"/>
        </StackPanel>
    </ScrollViewer>
</Page>
