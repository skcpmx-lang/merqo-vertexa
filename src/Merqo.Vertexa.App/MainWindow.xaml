<Window x:Class="Merqo.Vertexa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MERQO VERTEXA" Height="720" Width="1180"
        Background="{DynamicResource BackgroundBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="12">
            <StackPanel>
                <TextBlock Text="MERQO VERTEXA" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,8,8,20"/>
                <Button Style="{StaticResource NavButton}" Content="📊 Dashboard" Tag="Dashboard" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🖥 Hardware" Tag="Hardware" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🔋 Battery" Tag="Battery" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="💾 Storage" Tag="Storage" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🧩 Drivers" Tag="Drivers" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🖥 Display Lab" Tag="DisplayLab" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⌨ Keyboard Lab" Tag="KeyboardLab" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="🔊 Audio Lab" Tag="AudioLab" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="📄 Reports" Tag="Reports" Click="Nav_Click"/>
                <Button Style="{StaticResource NavButton}" Content="⚙ Settings" Tag="Settings" Click="Nav_Click"/>
            </StackPanel>
        </Border>

        <!-- Main area: top bar + content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,0">
                <TextBlock x:Name="TopBarTitle" Text="Dashboard" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
            </Border>
            <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="12,0">
                <TextBlock x:Name="StatusBar" Text="Ready" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
